# ---- LLM API (any endpoint speaking the OpenAI chat-completions protocol) ----
# "OpenAI-compatible" names the request/response format, not a vendor:
# this project does NOT use OpenAI models unless you point LLM_API_BASE at them.
# The default endpoint and model below are Tencent Hunyuan.
# Optional: leave LLM_API_KEY empty to run in offline mode — the server then writes
# a local rules-based report, and falls back to it whenever the model fails.
# Required only when you want the model-generated report.
LLM_API_KEY=your_api_key_here
# Base URL without the trailing /chat/completions
LLM_API_BASE=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=hunyuan-2.0-instruct-20251111
LLM_MAX_TOKENS=4096

# ---- Server ----
PORT=3000
HOST=127.0.0.1

# ---- Reliability ----
# Per-attempt timeout in milliseconds
LLM_TIMEOUT_MS=120000
# Retries on 429 / 5xx / network errors
LLM_RETRIES=2

# ---- Limits ----
# Max JSON request body (bytes)
MAX_BODY_BYTES=20971520
# Max uploaded file size (bytes)
MAX_EXTRACT_BYTES=20971520
# Max characters for JD / resume / extracted text
MAX_TEXT_CHARS=60000

# ---- CORS ----
# Extra allowed origins, comma separated (localhost is always allowed)
# ALLOWED_ORIGINS=https://your-site.example
